# 登录令牌有效期（秒），默认 28800 = 8 小时
ADMIN_TOKEN_TTL=28800

# ---------------------------------------------------------------------------
# MySQL 数据源（只读账号！不要给写权限）
# 只有 DB_A_*（douyinxs，备份参考）；B 数据源（userxs 老库）已废弃删除（2026-10-11）
# ---------------------------------------------------------------------------
DB_A_HOST=mysql7.sqlpub.com
DB_A_PORT=3312
DB_A_USER=readonly_user
DB_A_PASSWORD=changeme
DB_A_NAME=douyinxs
DB_A_LABEL=主库 · douyinxs
# 首日是累计快照，lastN（近 N 天增量）口径要排除它
DB_A_EXCLUDE_BASELINE=1

# 旧变量名仍兼容（DB_HOST 只映射到 A）
MYSQL_HOST=mysql7.sqlpub.com
MYSQL_PORT=3312
MYSQL_USER=readonly_user
MYSQL_PASSWORD=changeme
MYSQL_DATABASE=douyinxs

# ---------------------------------------------------------------------------
# 运行时
# ---------------------------------------------------------------------------
PORT=8787
SQLITE_PATH=/app/data/app.db
# 管理员口令（**必填**，登录管理后台用）。2026-10-11 起 fail-closed：
# 不填 = 没有兜底口令，管理接口全部 503 关闭，服务默认也拒绝启动。
# 请填强随机值（如 openssl rand -base64 24）并定期轮换。
ADMIN_PASSWORD=
# 微信私聊提权口令（可选）：在微信里私聊机器人发送该口令，可把当前会话提为管理员。
# 不填 = 禁用私聊提权（未配置时发任何口令都无效，且不暴露是否已配置）。
# WECHAT_ADMIN_CODE=
# 音浪/主播缓存秒数，默认 600
WAVE_CACHE_TTL=600
# 微信推送分批（1.0.1，150 人规模防 iLink 频控）：每批人数（默认 20）+ 批间隔秒（默认 3）
# WX_PUSH_BATCH_SIZE=20
# WX_PUSH_BATCH_INTERVAL_SECS=3
# 本地开发填 1：关闭展示端「河南 / 安徽」地区拦截（访问日志照记）；生产留空
IP_GATE_DISABLED=
# 门禁数据源（逗号分隔，未知名忽略，留空回默认 pconline,baidu,ip9）；生产留空即默认
IP_GATE_SOURCES=
# 后台「IP 查询」面板数据源（逗号分隔，留空回默认 ip.sb,ip2location,ipwhois）；生产留空即默认
IP_QUERY_SOURCES=
# 前后端不同域时才需要（默认同源，不用设）。多个用逗号分隔。
# CORS_ORIGINS=https://admin.example.com

# ---------------------------------------------------------------------------
# WorkBuddy 用量看板网关（展示端注册时「添加账号 OAuth」用）
# ---------------------------------------------------------------------------
# 面板地址，默认 http://64.188.8.149:8788
# WORKBUDDY_PANEL_URL=http://64.188.8.149:8788
# 面板密码（对应看板 ?tab=gateway 里「+ 添加账号 (OAuth)」用的同一套面板口令）。
# 只留在服务端环境变量里，绝不下发浏览器。
# **不填 = 注册页隐藏 OAuth 步骤**（手机号注册本身照常可用，只是不自动加账号池）。
# WORKBUDDY_PANEL_PASSWORD=
