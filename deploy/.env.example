# 登录令牌有效期（秒），默认 28800 = 8 小时
ADMIN_TOKEN_TTL=28800

# ---------------------------------------------------------------------------
# 唯一业务数据源：PostgreSQL（只读账号；写接口走 DB_WRITER_*）
# ---------------------------------------------------------------------------
DB_LOCAL_HOST=127.0.0.1
DB_LOCAL_PORT=5432
DB_LOCAL_USER=pk_reader
DB_LOCAL_PASSWORD=changeme
DB_LOCAL_NAME=douyin_dev
DB_LOCAL_LABEL=PostgreSQL 业务库
DB_LOCAL_READONLY=1

# ---------------------------------------------------------------------------
# 运行时
# ---------------------------------------------------------------------------
PORT=8787
SQLITE_PATH=/app/data/app.db
# 管理员口令（**必填**，登录管理后台用）。2026-10-11 起 fail-closed：
# 不填 = 没有兜底口令，管理接口全部 503 关闭，服务默认也拒绝启动。
# 请填强随机值（如 openssl rand -base64 24）并定期轮换。
ADMIN_PASSWORD=
# 内置展示端管理员账号（2026-10-17，可选但**上线建议配**）：
# 格式 name:pass:viewTeam，逗号分隔；pass 省略 = 与账号同名，viewTeam 省略 = any。
# 取值：any（全团）/ male（只看男团）/ female（只看女团）。
# 服务每次启动幂等补齐（已有账号只同步 is_admin 与 view_team，不覆盖密码）。
# 例如三位管理员：
# BUILTIN_MY_ACCOUNTS=浩雨:强口令:any,饭团:强口令:female,鹏先生:强口令:any
# 不配 = 一个内置账号都不建（默认安全，走管理端后台开号）。
BUILTIN_MY_ACCOUNTS=

# ---------------------------------------------------------------------------
# 机器人渠道（QQ / 微信）
# ---------------------------------------------------------------------------
# QQ 管理员白名单（逗号分隔 QQ 号）—— 2026-10-17 起 **fail-closed**：
# 未配置 = QQ 渠道没有任何管理员（会话静默忽略）。本地要用 QQ 命令时填自己的 QQ 号。
BOT_QQ_ADMINS=
# 微信管理员会话白名单（逗号分隔会话 ID / openid；留空 = 不额外放行）
BOT_WECHAT_ADMINS=
# QQ 开放平台机器人凭据（本地一般留空 = QQ 渠道不启动）
BOT_QQ_APP_ID=
BOT_QQ_APP_SECRET=
# 微信 iLink token（可留空；扫码登录成功后持久化到业务库 config 表）
BOT_WECHAT_TOKEN=
# 每会话限流（条/分钟，默认 10）
BOT_RATE_LIMIT=10
# 微信私聊提权口令（可选）：在微信里私聊机器人发送该口令，可把当前会话提为管理员。
# 不填 = 禁用私聊提权（未配置时发任何口令都无效，且不暴露是否已配置）。
WECHAT_ADMIN_CODE=
# QQ 沙箱（本地联调 QQ 机器人时设 1）/ 仅私聊（默认只私聊，设 0 恢复群聊）
BOT_QQ_SANDBOX=
BOT_QQ_PRIVATE_ONLY=
# 附件 CDN 域名额外白名单（逗号分隔；本地 e2e 需放行 127.0.0.1/localhost）
BOT_ATTACHMENT_HOSTS=
# 音浪/主播缓存秒数，默认 600
WAVE_CACHE_TTL=600
# 微信推送分批（1.0.1，150 人规模防 iLink 频控）：每批人数（默认 20）+ 批间隔秒（默认 3）
# WX_PUSH_BATCH_SIZE=20
# WX_PUSH_BATCH_INTERVAL_SECS=3
# 本地开发填 1：关闭展示端「河南 / 安徽」地区拦截（访问日志照记）；生产留空
IP_GATE_DISABLED=
# 门禁数据源（逗号分隔，未知名忽略，留空回默认 pconline,baidu,ip9）；生产留空即默认
IP_GATE_SOURCES=
# 后台「IP 查询」面板数据源（逗号分隔，留空回默认 ip.sb,ip2location,ipwhois）；生产留空即默认
IP_QUERY_SOURCES=
# 门禁 IP 白名单（精确 IP 或 CIDR，逗号分隔；本地一般不配 = 不额外放行）
# IP_GATE_ALLOWLIST=
# 前后端不同域时才需要（默认同源，不用设）。多个用逗号分隔。
# CORS_ORIGINS=https://admin.example.com

# ---------------------------------------------------------------------------
# WorkBuddy 用量看板网关（展示端注册时「添加账号 OAuth」用）
# 注（2026-10-17 审计 E-P3-8）：当前版本代码**未读取** WORKBUDDY_PANEL_*，
# 保留仅供将来恢复该功能；没真用之前不要往里填真实凭证。
# ---------------------------------------------------------------------------
# 面板地址（示例占位；真实地址只写本机 .env，不要入库）
# WORKBUDDY_PANEL_URL=http://<PANEL_HOST>:8788
# 面板密码（对应看板 ?tab=gateway 里「+ 添加账号 (OAuth)」用的同一套面板口令）。
# 只留在服务端环境变量里，绝不下发浏览器。
# **不填 = 注册页隐藏 OAuth 步骤**（手机号注册本身照常可用，只是不自动加账号池）。
# WORKBUDDY_PANEL_PASSWORD=

# ---------------------------------------------------------------------------
# Redis 缓存 / 锁层（P0，docs/17 §7.3）：只放可丢的派生数据（缓存 / 锁 / 去重标记），
# 事实永远在 PG。停 Redis 自动降级回内存缓存 + 直查 PG，服务照常。
# ---------------------------------------------------------------------------
# 容器内走 compose 服务名 pk-redis（docker 内网，不发布宿主端口），口令与
# compose 里 pk-redis 的 requirepass / 健康检查保持同一个值（openssl rand -base64 24）。
# 本地开发**不配这两个变量 = 全内存模式**，行为与引入 Redis 之前完全一致。
REDIS_PASSWORD=
REDIS_URL=redis://:${REDIS_PASSWORD}@pk-redis:6379/0
# 连接池上限，默认 4
REDIS_POOL_LIMIT=4

# ---------------------------------------------------------------------------
# 抖音头像同步（2026-10-17 起默认冻结）
# ---------------------------------------------------------------------------
# 1 = 冻结（推荐）：自动定时器 / 管理端同步接口 / `pk-server sync-avatars` CLI 三条入口
#     全停，不请求抖音、不写库；**已留存的头像照常展示**（展示端只读 person_avatar，不破图）。
# 0 / 不配 = 恢复更新（自动定时器另受 AVATAR_SYNC_ENABLED 控制，默认关）。
# 冻结理由：抖音抓取链路不稳定，且主播抖音号会换，换了号留存的就不是本人头像。
AVATAR_SYNC_DISABLED=1
# 恢复更新后才用得到（compose 已透传；不配 = 代码默认）：
# AVATAR_SYNC_ENABLED=1          # 打开后台自动定时器（默认关）
# AVATAR_SYNC_DAYS=7             # 头像新鲜度阈值（天）
# AVATAR_SYNC_CHECK_SECS=21600   # 后台检查间隔（秒，默认 6 小时）

# ---------------------------------------------------------------------------
# 对外发送闸门（2026-10-17 起**全开**）
# ---------------------------------------------------------------------------
# 1 / true = 真实发送（微信推送 / QQ 回复 / 管理员消息下发）—— **当前口径，上线默认**。
# 0 / 不配  = 所有对外发送只记 WARN 日志、不真发（仅排查 / 回滚时临时改）。
PUSH_OUT_ENABLED=1
# 收件人白名单（逗号分隔的展示端账号名）。留空 = 不额外限制、全部放行；
# 想先灰度给几个人时填名字。总闸没开时这一项无意义。
PUSH_OUT_ALLOW=
# ---------------------------------------------------------------------------
# TTS → MP3（微信“个人每日播报 / 语音日报”）
# ---------------------------------------------------------------------------
# auto：有 TTS_API_URL 走 HTTP；否则 macOS 用 say + ffmpeg；Linux 未配置时保留文字。
# TTS_PROVIDER=auto
# OpenAI 兼容 audio/speech 接口（完整 URL）
# TTS_API_URL=https://api.openai.com/v1/audio/speech
# TTS_API_KEY=
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# TTS_FORMAT=mp3
# TTS_SPEED=1.0
# TTS_TIMEOUT_SECS=90
# TTS_MAX_CHARS=4000
# macOS 本地后端
# TTS_MACOS_VOICE=Tingting
# TTS_FFMPEG=ffmpeg

# 推送延迟（分钟，默认 30；0 = 入库即推）
# PUSH_DELAY_MINUTES=30
# 单次推送总时长上限（秒，默认 180）
# PUSH_MAX_TOTAL_SECS=180
