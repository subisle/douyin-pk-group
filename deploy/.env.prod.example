# 147 生产环境变量（拷到 /opt/pk-server/.env.prod，chmod 600）
# 容器镜像（GHCR）
GHCR_REPO=你的GitHub用户名/抖音pk分组
PK_TAG=latest
# PG（业务库）
PG_PASSWORD= change_me_strong
# 音浪读源（sqlpub，现网同值）
DB_A_HOST=mysql5.sqlpub.com
DB_A_PORT=3306
DB_A_NAME=填写
DB_A_USER=填写
DB_A_PASSWORD=填写
# 管理口令
ADMIN_PASSWORD= change_me
# 内置展示端管理员账号（2026-10-17，可选）：格式 name:pass:viewTeam，逗号分隔；
# viewTeam = any / male / female。服务启动幂等补齐（不覆盖已改过的密码）。
# 例：浩雨:强口令:any,饭团:强口令:female,鹏先生:强口令:any
BUILTIN_MY_ACCOUNTS=

# ---------------------------------------------------------------------------
# 出网闸门（2026-10-17 起**全开**）
# ---------------------------------------------------------------------------
# 1 / true = 真实发送（微信推送 / QQ 回复 / 管理员下发）—— **上线口径，默认**。
# 设 0 / false = 所有对外发送只记日志、不真发（仅排查 / 回滚时临时改）。
# 2026-10-17 之前生产编排根本没有这一项 → 静默走默认关，主播一条都收不到。
PUSH_OUT_ENABLED=1
# 收件人白名单（逗号分隔的展示端账号名）。留空 = 不额外限制、全部放行；
# 想先灰度给几个人（如「浩雨」）时填名字。出网总闸没开时这一项无意义。
PUSH_OUT_ALLOW=
