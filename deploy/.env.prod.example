# 147 生产环境变量（拷到 /opt/pk-server/.env.prod，chmod 600）
# 容器镜像（GHCR）
GHCR_REPO=你的GitHub用户名/抖音pk分组
PK_TAG=latest
# PG（业务库）
PG_PASSWORD=change_me_strong
# 缓存口令（2026-10-17 审计补：pk-redis 加了 requirepass，pk-server 的
# REDIS_URL 由 compose 用这个值拼出，两边同源不会配岔）
REDIS_PASSWORD=change_me_redis
# 音浪读源（远程 MySQL，现网同源）。**主机名用占位**：真实值只写部署机
# .env.prod，本文件不允许出现生产主机/IP/账号。
DB_A_HOST=db.example.com
DB_A_PORT=3306
DB_A_NAME=填写
DB_A_USER=填写
DB_A_PASSWORD=填写
# 管理口令（**强随机、勿复用本机开发口令** —— 旧值已随公开 git 历史泄露）
ADMIN_PASSWORD=change_me_admin
# 内置展示端管理员账号（2026-10-17，可选）：格式 name:pass:viewTeam，逗号分隔；
# viewTeam = any / male / female。服务启动幂等补齐（不覆盖已改过的密码）。
# 例：浩雨:强口令:any,饭团:强口令:female,鹏先生:强口令:any
# 生产开号必须换强口令，不要照抄本地 .env 的开发口令。
BUILTIN_MY_ACCOUNTS=

# ---------------------------------------------------------------------------
# 机器人渠道（QQ / 微信）—— 2026-10-17 第四轮审计 P1-3 起 QQ 管理员 fail-closed
# ---------------------------------------------------------------------------
# ⚠️ **生产必填**：QQ 渠道只有这里列出的 QQ 号（逗号分隔）才算管理员；
# 留空 = 一个都不认，任何 QQ 私聊都会被静默忽略（不再默认全放开）。
# 只填运营自持的 QQ 号，不要填群号；改完重启 pk-server 生效。
BOT_QQ_ADMINS=
# 微信管理员会话白名单（逗号分隔会话 ID / openid）。留空 = 不额外放行，
# 需要给某个微信会话管理员权限时，优先用后台「机器人」页勾选或本机提权口令。
BOT_WECHAT_ADMINS=
# QQ 开放平台机器人凭据（不配 = QQ 渠道不启动；要用 QQ 就**生产必填**）
BOT_QQ_APP_ID=
BOT_QQ_APP_SECRET=
# 微信 iLink token（可留空：扫码登录成功后持久化到业务库 config 表）
BOT_WECHAT_TOKEN=
# 每会话限流（条/分钟，留空 = 代码默认 10）
BOT_RATE_LIMIT=10
# 微信私聊提权口令（可选；留空 = 提权路径整体关闭，任何口令都无效）
WECHAT_ADMIN_CODE=
# QQ 沙箱 / 仅私聊（本地联调才需要，生产留空 = 正式环境 + 只服务私聊）
BOT_QQ_SANDBOX=
BOT_QQ_PRIVATE_ONLY=
# 附件 CDN 域名额外白名单（逗号分隔；平台换 CDN 导致导入 100% 失败时应急放行）
BOT_ATTACHMENT_HOSTS=

# ---------------------------------------------------------------------------
# 出网闸门（2026-10-17 起**全开**）
# ---------------------------------------------------------------------------
# 1 / true = 真实发送（微信推送 / QQ 回复 / 管理员下发）—— **上线口径，默认**。
# 设 0 / false = 所有对外发送只记日志、不真发（仅排查 / 回滚时临时改）。
# 2026-10-17 之前生产编排根本没有这一项 → 静默走默认关，主播一条都收不到。
PUSH_OUT_ENABLED=1
# 收件人白名单（逗号分隔的展示端账号名）。留空 = 不额外限制、全部放行；
# 想先灰度给几个人（如「浩雨」）时填名字。出网总闸没开时这一项无意义。
PUSH_OUT_ALLOW=
# 推送节奏（compose 已透传，留空 = 代码默认）：
# 延迟分钟（默认 30；0 = 入库即推）/ 单次推送总时长上限秒（默认 180）
# PUSH_DELAY_MINUTES=30
# PUSH_MAX_TOTAL_SECS=180
# 微信分批（150 人规模防 iLink 频控）：每批人数默认 20 + 批间隔秒默认 3
# WX_PUSH_BATCH_SIZE=20
# WX_PUSH_BATCH_INTERVAL_SECS=3

# ---------------------------------------------------------------------------
# 头像同步总闸（2026-10-17 用户点单冻结，生产默认冻结）
# ---------------------------------------------------------------------------
# compose 已显式注入 AVATAR_SYNC_DISABLED="1"；这里留注释作备忘。
# 要恢复同步：删掉 docker-compose.prod.yml 里那行 + 本文件的同名行，重启生效。
# AVATAR_SYNC_DISABLED=1
# 恢复同步后才用得到（compose 已透传；留空 = 代码默认）：
# AVATAR_SYNC_ENABLED=1          # 打开后台自动定时器（默认关）
# AVATAR_SYNC_DAYS=7             # 头像新鲜度阈值（天）
# AVATAR_SYNC_CHECK_SECS=21600   # 后台检查间隔（秒，默认 6 小时）

# ---------------------------------------------------------------------------
# IP 闸门（展示端访客拦截）。生产留空/不配 = 拦截开启（本意如此）。
# ---------------------------------------------------------------------------
# 仅当要把某些出口 IP 加白时才配，例：IP_GATE_ALLOWLIST=203.0.113.10
IP_GATE_SOURCES=
IP_QUERY_SOURCES=
IP_GATE_ALLOWLIST=
# 临时排障才设 1（关闭展示端地区拦截）；排障完必须删掉 / 置空，生产常态留空
IP_GATE_DISABLED=
# 跨域白名单（默认同源部署，留空即可；前后端不同域时才填，逗号分隔）
CORS_ORIGINS=

# ---------------------------------------------------------------------------
# 展示端注册页 OAuth 跳板（漏配 = 注册页 OAuth 步骤静默消失）
# 注（2026-10-17 审计 E-P3-8）：当前版本代码**未读取** WORKBUDDY_PANEL_*，
# compose 也未透传；保留仅供将来恢复该功能，**勿在 .env.prod 填真实凭证**。
# ---------------------------------------------------------------------------
WORKBUDDY_PANEL_URL=
WORKBUDDY_PANEL_PASSWORD=
# 管理员登录态时长（秒，默认 28800 = 8 小时）
ADMIN_TOKEN_TTL=28800
