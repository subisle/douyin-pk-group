# pk-group 的公网入口示例。
#
# 服务本身只监听 127.0.0.1:8787，公网流量全部由 Caddy 收口：
#   - /s/*   对外展示页（任何人可访问，无需口令）
#   - 其余    管理员后台（应用层校验 ADMIN_PASSWORD）
#
# 用法：把下面内容并到 64 上现有的 Caddyfile，重载即可。

pk.example.com {
	encode zstd gzip

	# 展示页缓存短一点：音浪每小时更新，静态资源可以长缓存
	@share path /s/*
	header @share Cache-Control "public, max-age=60"

	# 后台不要任何缓存，避免改完分组还看到旧页面
	@admin not path /s/* /api/*
	header @admin Cache-Control "no-store"

	# 简单限流，避免有人拿展示页刷接口
	rate_limit {
		zone pk_group {
			key    {remote_host}
			events 120
			period 10s
		}
	}

	# Docker 部署：容器只发 127.0.0.1，用 host 网络反代
	reverse_proxy 127.0.0.1:8787

	log {
		output file /var/log/caddy/pk-group.log
		format json
	}
}

# ---------------------------------------------------------------------------
# 只想给展示页单独一个域名、后台走另一个域名时，拆成两个 site：
#
# share.example.com {
# 	reverse_proxy 127.0.0.1:8787
# }
#
# admin.example.com {
# 	# 后台可以再加一层来源限制
# 	@notAllowed not remote_ip 127.0.0.1 10.0.0.0/8 192.168.0.0/16
# 	respond @notAllowed 403
# 	reverse_proxy 127.0.0.1:8787
# }
# ---------------------------------------------------------------------------
