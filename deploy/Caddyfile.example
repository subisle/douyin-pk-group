# pk-group 的公网入口示例。
#
# 服务本身只监听 127.0.0.1:8787，公网流量全部由 Caddy 收口：
#   - /            对外展示页（任何人可访问，无需口令；/1 /0 /report /lineage /my*
#                  /wechat* /group* /st/* 都是同一展示页的深链/兼容路径）
#   - /admin*      管理员后台（应用层校验登录口令；静态壳可匿名取，数据全靠 /api 鉴权）
#   - /api/*       接口（鉴权与缓存策略由应用自己下发，见下）
#
# 用法：把下面内容并到 64 上现有的 Caddyfile，重载即可。
#
# 2026-10-17 线上实测补充（64 上已生效，与本文件对齐）：
#   1. pk 站挂在 Cloudflare 橙云后（Proxied），源站 443 用 iptables 收成 CF-only
#      白名单（脚本 /usr/local/sbin/cf-whitelist-443.sh，幂等可重跑；CF 段变化时重跑）。
#      防的是「改 hosts 直连源站」绕过 CF 的抗丢包/缓存/DDoS 防护。
#      ⚠️ 副作用：TLS-ALPN-01 验证进不来，所以 Caddy 全局选项固定用 HTTP-01（走 80，
#      未封）。若曾用 dns-01/自签则不受影响。80 端口对公网保留全开（ACME + IP 兜底）。
#   2. 加了 :80 全局兜底块：http://<源站IP>/ 直连时 301 跳正式域名（原来是 308 跳
#      https://IP，无证书死路）。ACME 挑战路径 Caddy 会在内部短路，不受影响。

:80 {
	# IP 直连兜底（2026-10-17）：把「直接输 IP」的用户引回正式域名
	redir https://pk.example.com{uri} permanent
}

pk.example.com {
	encode zstd gzip

	# ---------------------------------------------------------------
	# 安全响应头（2026-10-17 第四轮审计 D 域）
	# 应用本身也下发 XFO / nosniff / Referrer-Policy，以及 CSP（强制
	# frame-ancestors 'none' + 完整策略的 Report-Only）；反代这里再兜一层同值头，
	# 防「绕过反代直连后端」之外的路径漏配。
	# ⚠️ CSP 由应用按文档类型下发（展示页是内联脚本/样式，管理端是 dist 产物），
	#    **不要在这里重复定义 Content-Security-Policy**，否则两套策略互相覆盖、
	#    Report-Only 的违规报告也会失真。
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# ---------------------------------------------------------------
	# 缓存：应用已按路径下发（spa.rs::cache_control / main.rs::cache_control_mw）——
	#   /assets/*、/fonts/* 长缓存；展示页 HTML、/admin 壳、/api/* 为 no-store/no-cache。
	# 反代不重复覆盖；若前面再加 CDN，按同样口径配置。

	# ---------------------------------------------------------------
	# 简单限流（可选）：依赖 caddy-ratelimit 插件（xcaddy build --with ...）。
	# 宿主未装该插件时 `caddy validate` 会因未知指令失败，所以默认**注释掉**；
	# 确认装好再把下面整段放开。
	# rate_limit {
	# 	zone pk_group {
	# 		key    {remote_host}
	# 		events 120
	# 		period 10s
	# 	}
	# }

	# Docker 部署：容器只发 127.0.0.1，用 host 网络反代
	# ---------------------------------------------------------------
	# 客户端真实 IP（2026-10-17）：链路是 CF → Caddy → docker-proxy → 容器，
	# 容器里 ConnectInfo 只会看到 Docker 网关（如 172.26.0.1），XFF 链尾是 CF
	# 边缘节点 IP —— 两者都不是真实访客。Cloudflare 会把真实客户端 IP 放在
	# CF-Connecting-IP 头里（橙云代理时由 CF 覆写，客户端伪造不了），这里显式
	# 转成 X-Real-IP 交给后端；没有该头时 header_up 会删掉 X-Real-IP，后端回落
	# 到 XFF 链尾（直连源站场景仍然正确）。应用侧信任边界见 ipinfo::request_ip。
	reverse_proxy 127.0.0.1:8787 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	log {
		output file /var/log/caddy/pk-group.log
		format json
	}
}

# ---------------------------------------------------------------------------
# 只想给展示页单独一个域名、后台走另一个域名时，拆成两个 site ——
# 顺带把「公开展示面」与「管理员特权面」隔到两个浏览器安全域
# （第四轮审计 D 域 P3-3：同源时展示页任何 XSS 都能直接打管理 API）。
#
# share.example.com {
# 	header {
# 		Strict-Transport-Security "max-age=31536000; includeSubDomains"
# 		X-Content-Type-Options "nosniff"
# 		X-Frame-Options "DENY"
# 		Referrer-Policy "strict-origin-when-cross-origin"
# 	}
# 	reverse_proxy 127.0.0.1:8787
# }
#
# admin.example.com {
# 	# 后台可以再加一层来源限制
# 	@notAllowed not remote_ip 127.0.0.1 10.0.0.0/8 192.168.0.0/16
# 	respond @notAllowed 403
# 	reverse_proxy 127.0.0.1:8787
# }
# ---------------------------------------------------------------------------
