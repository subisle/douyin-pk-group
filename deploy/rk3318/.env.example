MARIADB_ROOT_PASSWORD=change-me-root

# douyin_writer：业务写账号（DML，无 DDL）。pk-server 写池 + Go 过渡服务共用。
DOUYIN_WRITER_USER=douyin_writer
DOUYIN_WRITER_PASSWORD=change-me-writer

# pk_reader：只读账号（SELECT）。
PK_READER_USER=pk_reader
PK_READER_PASSWORD=change-me-reader

# douyin_migrator：DDL 专用账号，仅 `pk-server migrate` 显式触发时使用。
DOUYIN_MIGRATOR_USER=douyin_migrator
DOUYIN_MIGRATOR_PASSWORD=change-me-migrator

# douyin-server（Go 过渡服务）的 DSN 由 compose 从 DOUYIN_WRITER_USER/PASSWORD 自动拼接，
# 不要在这里另配一份（密码改漏会导致连库失败）。
