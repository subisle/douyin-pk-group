<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 构建脚本根据最终 APP_URL 写入窄域名例外；源码不保存第二份地址。 -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
