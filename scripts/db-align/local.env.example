# 数据库对齐 · 本地开发参数模板
#
# 用法：cp scripts/db-align/local.env.example scripts/db-align/local.env
#       （local.env 已在 .gitignore 里，**绝不入库**）
#
# 这里放的是**本机专用**参数；线上（64 服务器容器）参数走环境变量，
# 部署相关文件里不出现 127.0.0.1 / 本机路径这类本地值。

# ── 源端：本机唯一事实源 ────────────────────────────────────────────────
SRC_PG_HOST=127.0.0.1
SRC_PG_PORT=3318
SRC_PG_DB=douyin_dev
SRC_PG_USER=zmy
# 有口令时填；本机 trust/peer 认证留空即可
# SRC_PG_PASSWORD=

# ── 目标端模式 ──────────────────────────────────────────────────────────
# local      本机另一个 PG 库（本地对练 / 验证，不碰线上）
# docker-ssh 64 服务器上的 pk-postgres 容器（线上形态）
TARGET_MODE=local

# ── 目标端（TARGET_MODE=local 时使用）───────────────────────────────────
# 本地对练库：与源库同实例、不同库名（脚本会拒绝源/目标同名）
DST_PG_HOST=127.0.0.1
DST_PG_PORT=3318
DST_PG_DB=douyin_align_dst
DST_PG_USER=zmy
# DST_PG_PASSWORD=

# ── 目标端（TARGET_MODE=docker-ssh 时使用）─────────────────────────────
# 口令/密钥等机密不要写在这里，走环境变量或 ssh 密钥
# PK64_HOST=root@<64_HOST>
# PK64_CONTAINER=pk-postgres
# DST_PG_DB=douyin_dev
# DST_PG_USER=douyin_dev
